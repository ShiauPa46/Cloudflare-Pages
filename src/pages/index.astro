---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import IntroMd from "../data/intro.md";
import { SITE } from "../config";
---

<BaseLayout title={SITE.title}>
  <!-- Hero Section: Avatar, Name, Motto, Social Links -->
  <section class="hero">
    <div class="hero-bg glass-heavy"></div>
    <div class="hero-content">
      <img
        src="/Avatar.png"
        alt={SITE.name}
        class="avatar"
        width="140"
        height="140"
        loading="eager"
      />
      <h1 class="name">{SITE.name}</h1>
      <p class="english-name">{SITE.englishName}</p>
      <p class="motto">{SITE.motto}</p>
      <div class="social-wrapper">
        <SocialLinks />
      </div>
    </div>
    <div class="scroll-hint">
      <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
        <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z" />
      </svg>
    </div>
  </section>

  <!-- Self-Introduction Section -->
  <section class="intro-section container" id="intro">
    <div class="intro-card glass-heavy">
      <h2 class="section-title">关于我</h2>
      <div class="intro-content">
        <IntroMd />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* === Hero Section === */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 100px);
  text-align: center;
  position: relative;
  padding: 2rem 1.5rem;
}
.hero-content {
  position: relative;
  z-index: 1;
}
.avatar {
  width: 140px;
  height: 140px;
  border-radius: var(--radius-full);
  object-fit: cover;
  box-shadow: var(--md-elevation-3);
  border: 3px solid rgba(255, 255, 255, 0.6);
  margin-bottom: 1.5rem;
}
.name {
  font-family: var(--font-cn);
  font-size: 2.4rem;
  font-weight: 700;
  color: #D4ECEE;
  margin-bottom: 0.2rem;
  letter-spacing: 2px;
}
.english-name {
  font-family: var(--font-en);
  font-size: 1.1rem;
  color: #999;
  margin-bottom: 1rem;
  font-weight: 400;
  letter-spacing: 0.5px;
}
.motto {
  font-size: 1.05rem;
  color: var(--md-on-surface-variant);
  margin-bottom: 2rem;
  font-weight: 400;
  font-style: italic;
  letter-spacing: 0.5px;
  white-space: pre-line;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.7;
}
.social-wrapper {
  margin-top: 0.5rem;
}
.scroll-hint {
  position: absolute;
  bottom: 2rem;
  animation: bounce 2s infinite;
  color: var(--md-on-surface-variant);
  opacity: 0.6;
}
@keyframes bounce {
  0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
  40% { transform: translateY(8px); }
  60% { transform: translateY(4px); }
}

/* === Intro Section === */
.intro-section {
  padding: 2rem 1.5rem 4rem;
}
.section-title {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 1.25rem;
  color: var(--md-on-surface);
}
.intro-card {
  padding: 2rem 2.5rem;
}
.intro-content {
  line-height: 1.8;
  color: var(--md-on-surface);
}
.intro-content p {
  margin-bottom: 0.8rem;
}
.intro-content ul {
  padding-left: 1.5rem;
  margin-bottom: 0.8rem;
}
.intro-content li {
  margin-bottom: 0.3rem;
}
.intro-content code {
  background: var(--md-primary-container);
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
  font-size: 0.9em;
  font-family: 'Courier New', monospace;
}

@media (max-width: 600px) {
  .name {
    font-size: 1.8rem;
  }
  .avatar {
    width: 110px;
    height: 110px;
  }
  .intro-card {
    padding: 1.5rem;
  }
}
</style>
