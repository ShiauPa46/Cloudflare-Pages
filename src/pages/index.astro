---
import BaseLayout from "../layouts/BaseLayout.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { SITE } from "../config";
---

<BaseLayout title={SITE.title}>
  <!-- Hero Section: Avatar, Name, Motto, Social Links -->
  <section class="hero">
    <div class="hero-bg glass-heavy"></div>
    <div class="hero-content">
      <img
        src="/Avatar.png"
        alt={SITE.name}
        class="avatar"
        width="140"
        height="140"
        loading="eager"
      />
      <h1 class="name">{SITE.name}</h1>
      <p class="english-name">{SITE.englishName}</p>
      <p class="motto">{SITE.motto}</p>
      <div class="social-wrapper">
        <SocialLinks />
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  body {
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>

<style>
/* === Hero Section === */
.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  padding: 2rem 1.5rem;
}
.hero-content {
  position: relative;
  z-index: 1;
}
.avatar {
  width: 140px;
  height: 140px;
  border-radius: var(--radius-full);
  object-fit: cover;
  box-shadow: var(--md-elevation-3);
  border: 3px solid rgba(255, 255, 255, 0.6);
  margin-bottom: 1.5rem;
}
.name {
  font-family: var(--font-cn);
  font-size: 2.4rem;
  font-weight: 700;
  color: #D4ECEE;
  margin-bottom: 0.2rem;
  letter-spacing: 2px;
}
.english-name {
  font-family: var(--font-en);
  font-size: 1.1rem;
  color: #c4c4c4;
  margin-bottom: 1rem;
  font-weight: 400;
  letter-spacing: 0.5px;
}
.motto {
  font-size: 1.05rem;
  color: var(--md-on-surface-variant);
  margin-bottom: 2rem;
  font-weight: 400;
  font-style: italic;
  letter-spacing: 0.5px;
  white-space: pre-line;
  max-width: 480px;
  margin-left: auto;
  margin-right: auto;
  line-height: 1.7;
}
.social-wrapper {
  margin-top: 0.5rem;
}

@media (max-width: 600px) {
  .name {
    font-size: 1.8rem;
  }
  .avatar {
    width: 110px;
    height: 110px;
  }
}
</style>
