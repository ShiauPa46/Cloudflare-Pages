---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagBadge from "../../components/TagBadge.astro";
import DisqusComments from "../../components/DisqusComments.astro";
import { getCollection } from "astro:content";
import { DISQUS_SHORTNAME } from "../../config";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { slug, data, body } = post;
const { Content } = await post.render();
---

<BaseLayout title={`${data.title} - ShiauPa`} description={data.subtitle ?? data.title}>
  <article class="article-page container">
    <header class="article-header">
      {data.cover && (
        <div class="article-cover glass">
          <img src={data.cover} alt={data.title} />
        </div>
      )}
      <h1 class="article-title">{data.title}</h1>
      {data.subtitle && <p class="article-subtitle">{data.subtitle}</p>}
      <div class="article-meta">
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
      {data.tags && data.tags.length > 0 && (
        <div class="article-tags">
          <TagBadge tags={data.tags} />
        </div>
      )}
    </header>

    <div class="article-body glass-heavy">
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/blog" class="back-link">&larr; 返回博客列表</a>
    </footer>

    <!-- Disqus Comments -->
    <DisqusComments shortname={DISQUS_SHORTNAME} slug={slug} title={data.title} />
  </article>
</BaseLayout>

<style>
.article-page {
  padding: 3rem 1.5rem 4rem;
}
.article-header {
  text-align: center;
  margin-bottom: 2rem;
}
.article-cover {
  max-width: 700px;
  margin: 0 auto 1.5rem;
  border-radius: var(--radius-lg);
  overflow: hidden;
}
.article-cover img {
  width: 100%;
  display: block;
}
.article-title {
  font-size: 2.2rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 0.6rem;
}
.article-subtitle {
  font-size: 1.1rem;
  color: var(--md-on-surface-variant);
  margin-bottom: 0.8rem;
}
.article-meta {
  font-size: 0.9rem;
  color: var(--md-on-surface-variant);
  opacity: 0.8;
  margin-bottom: 0.8rem;
}
.article-tags {
  display: flex;
  justify-content: center;
}
.article-body {
  max-width: 750px;
  margin: 0 auto 2rem;
  padding: 2rem 2.5rem;
  line-height: 1.9;
  font-size: 1.05rem;
  border-radius: var(--radius-xl);
}
.article-body :global(img) {
  max-width: 100%;
  border-radius: var(--radius-md);
  margin: 1rem 0;
}
.article-body :global(h1),
.article-body :global(h2),
.article-body :global(h3) {
  margin-top: 1.8rem;
  margin-bottom: 0.8rem;
  line-height: 1.3;
}
.article-body :global(h2) {
  font-size: 1.6rem;
}
.article-body :global(h3) {
  font-size: 1.3rem;
}
.article-body :global(p) {
  margin-bottom: 1rem;
}
.article-body :global(ul),
.article-body :global(ol) {
  padding-left: 1.5rem;
  margin-bottom: 1rem;
}
.article-body :global(li) {
  margin-bottom: 0.4rem;
}
.article-body :global(blockquote) {
  border-left: 3px solid var(--md-primary);
  padding-left: 1rem;
  margin: 1rem 0;
  color: var(--md-on-surface-variant);
  font-style: italic;
}
.article-body :global(code) {
  background: var(--md-surface);
  padding: 0.15rem 0.4rem;
  border-radius: 4px;
  font-size: 0.9em;
}
.article-body :global(pre) {
  background: var(--md-surface);
  padding: 1rem 1.25rem;
  border-radius: var(--radius-md);
  overflow-x: auto;
  margin: 1rem 0;
}
.article-footer {
  max-width: 750px;
  margin: 0 auto;
}
.back-link {
  font-weight: 500;
  color: var(--md-primary);
}
.back-link:hover {
  text-decoration: underline;
}
@media (max-width: 600px) {
  .article-title {
    font-size: 1.6rem;
  }
  .article-body {
    padding: 1.25rem 1.5rem;
    font-size: 1rem;
  }
}
</style>
