---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Gather all tags with counts
const tagCounts: Record<string, number> = {};
posts.forEach((p) => {
  p.data.tags?.forEach((t) => {
    tagCounts[t] = (tagCounts[t] || 0) + 1;
  });
});
const allTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="博客 - ShiauPa">
  <div class="container blog-page">
    <h1 class="page-title">博客</h1>

    <!-- Tag Filter -->
    {allTags.length > 0 && (
      <nav class="tag-filter" id="tagFilter">
        <a href="/blog" class="tag-filter-item active" data-tag="">全部</a>
        {allTags.map(([tag, count]) => (
          <a href={`/tags/${tag}`} class="tag-filter-item" data-tag={tag}>
            {tag} <span class="tag-count">{count}</span>
          </a>
        ))}
      </nav>
    )}

    <!-- Blog List -->
    {posts.length === 0 ? (
      <div class="empty glass">
        <p>还没有文章，敬请期待...</p>
      </div>
    ) : (
      <div class="blog-grid" id="blogGrid">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    )}

    <div class="empty glass" id="emptyMsg" style="display:none">
      <p>该标签下暂无文章。</p>
    </div>
  </div>
</BaseLayout>

<style>
.blog-page {
  padding: 3rem 1.5rem 4rem;
}
.page-title {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  text-align: center;
}
.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: center;
  margin-bottom: 2.5rem;
}
.tag-filter-item {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.85rem;
  font-weight: 500;
  padding: 0.4rem 0.9rem;
  border-radius: var(--radius-full);
  background: #D4ECEE;
  border: 1px solid var(--md-outline);
  color: var(--md-on-surface-variant);
  transition: all 0.2s;
}
.tag-filter-item:hover,
.tag-filter-item.active {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
  border-color: var(--md-primary);
}
.tag-count {
  font-size: 0.75rem;
  opacity: 0.7;
}
.blog-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
  gap: 1.5rem;
}
.empty {
  text-align: center;
  padding: 3rem;
  color: var(--md-on-surface-variant);
  font-size: 1.1rem;
}
@media (max-width: 600px) {
  .blog-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
  (function() {
    const grid = document.getElementById('blogGrid');
    const emptyMsg = document.getElementById('emptyMsg');
    if (!grid) return;

    function filterByTag(tag) {
      // Update active state on filter items
      document.querySelectorAll('.tag-filter-item').forEach(el => {
        el.classList.toggle('active', (el.dataset.tag || '') === tag);
      });

      let visibleCount = 0;
      document.querySelectorAll('.blog-card').forEach(card => {
        const tags = (card.dataset.tags || '').split(',').filter(Boolean);
        if (!tag || tags.includes(tag)) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      // Show empty message if no cards visible
      grid.style.display = visibleCount === 0 ? 'none' : '';
      if (emptyMsg) emptyMsg.style.display = visibleCount === 0 ? '' : 'none';
    }

    function getTagFromPath() {
      const parts = window.location.pathname.replace(/\/$/, '').split('/');
      if (parts[1] === 'tags' && parts[2]) {
        return decodeURIComponent(parts[2]);
      }
      return '';
    }

    // Click handlers — intercept tag clicks for client-side filtering
    document.querySelectorAll('.tag-filter-item').forEach(item => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        const tag = item.dataset.tag || '';
        const url = tag ? `/tags/${encodeURIComponent(tag)}` : '/blog';
        history.pushState(null, '', url);
        filterByTag(tag);
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    // Handle back/forward navigation
    window.addEventListener('popstate', () => {
      filterByTag(getTagFromPath());
    });

    // On page load, check if current URL has a tag
    const currentTag = getTagFromPath();
    if (currentTag) {
      filterByTag(currentTag);
    }
  })();
</script>
