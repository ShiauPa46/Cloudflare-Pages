---
import { SITE } from "../config";
---

<header class="navbar glass-heavy">
  <div class="navbar-inner container-wide">
    <a href="/" class="nav-brand">{SITE.name}</a>
    <nav class="nav-links">
      <a href="/">首页</a>
      <a href="/blog">博客</a>
      <a href="/friends">友链</a>
    </nav>
  </div>
</header>

<style>
.navbar {
  position: sticky;
  top: 12px;
  z-index: 100;
  margin: 12px auto 0;
  max-width: 1100px;
  border-radius: var(--radius-xl);
}
.navbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1.5rem;
}
.nav-brand {
  font-family: var(--font-en);
  font-size: 1.3rem;
  font-weight: 700;
  color: var(--md-primary);
  letter-spacing: -0.5px;
}
.nav-brand:hover {
  color: #3A7BC8;
}
.nav-links {
  display: flex;
  gap: 1.5rem;
}
.nav-links a {
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--md-on-surface-variant);
  padding: 0.35rem 0.75rem;
  border-radius: var(--radius-full);
  transition: background 0.2s, color 0.2s;
}
.nav-links a:hover,
.nav-links a.active {
  background: var(--md-primary-container);
  color: var(--md-on-primary-container);
}
@media (max-width: 600px) {
  .navbar {
    margin: 8px 8px 0;
    top: 8px;
  }
  .nav-links {
    gap: 0.5rem;
  }
  .nav-links a {
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
  }
}
</style>
