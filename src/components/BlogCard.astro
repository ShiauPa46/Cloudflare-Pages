---
import TagBadge from "./TagBadge.astro";
import type { CollectionEntry } from "astro:content";

const { post } = Astro.props;
const { slug, data } = post;
const href = `/blog/${slug}`;
---

<article class="blog-card card">
  <a href={href} class="card-link">
    {data.cover && (
      <div class="card-cover">
        <img src={data.cover} alt={data.title} loading="lazy" />
      </div>
    )}
    <div class="card-body">
      <h2 class="card-title">{data.title}</h2>
      {data.subtitle && <p class="card-subtitle">{data.subtitle}</p>}
      <div class="card-meta">
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
      {data.tags && data.tags.length > 0 && (
        <div class="card-tags">
          <TagBadge tags={data.tags} />
        </div>
      )}
    </div>
  </a>
</article>

<style>
.blog-card {
  overflow: hidden;
  transition: box-shadow 0.3s ease, transform 0.3s ease;
}
.card-link {
  display: block;
  color: inherit;
}
.card-link:hover {
  color: inherit;
}
.card-cover {
  width: 100%;
  height: 200px;
  overflow: hidden;
}
.card-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}
.blog-card:hover .card-cover img {
  transform: scale(1.05);
}
.card-body {
  padding: 1.25rem 1.5rem 1.5rem;
}
.card-title {
  font-size: 1.35rem;
  font-weight: 700;
  line-height: 1.3;
  margin-bottom: 0.35rem;
  color: var(--md-on-surface);
}
.card-subtitle {
  font-size: 0.9rem;
  color: var(--md-on-surface-variant);
  margin-bottom: 0.75rem;
  line-height: 1.5;
}
.card-meta {
  font-size: 0.8rem;
  color: var(--md-on-surface-variant);
  opacity: 0.8;
  margin-bottom: 0.6rem;
}
.card-tags {
  margin-top: 0.5rem;
}
</style>
