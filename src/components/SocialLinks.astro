  qq: "M12 1C7.05 1 3 4.48 3 8.8c0 0 1.8.4 2.8.1.8 2.8 2.8 5.5 5.2 6.5-.8.8-1.7 2.5-1.7 4.3 0 1.3.4 1.8 1.2 1.8s1.2-.5 1.2-1.8c0-1.8-.9-3.5-1.7-4.3 2.4-1 4.4-3.7 5.2-6.5 1 .3 2.8-.1 2.8-.1C21 4.48 16.95 1 12 1z",
